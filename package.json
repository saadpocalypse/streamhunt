{
  "name": "streamhunt",
  "version": "1.0.0",
  "description": "Production-grade streaming availability CLI tool powered by Watchmode API",
  "type": "module",
  "bin": {
    "streamhunt": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadpocalypse/streamhunt.git"
  },
  "bugs": {
    "url": "https://github.com/saadpocalypse/streamhunt/issues"
  },
  "homepage": "https://github.com/saadpocalypse/streamhunt#readme",
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js || true",
    "prepublishOnly": "npm test && npm run build",
    "watch": "tsc --watch",
    "start": "node ./dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "streaming",
    "movies",
    "tv-shows",
    "watchmode",
    "cli",
    "entertainment",
    "cord-cutting"
  ],
  "author": "Ahmad Saad",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
